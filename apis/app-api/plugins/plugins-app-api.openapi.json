{
  "openapi": "3.1.0",
  "info": {
    "title": "SDKWork Plugins App API",
    "version": "1.0.0",
    "description": "Marketplace authority for the SDKWork Plugins capability: read-only plugin catalog and category listing served under /app/v3/api. Success bodies use the SdkWorkApiResponse envelope; errors use application/problem+json.",
    "x-sdkwork-owner": "sdkwork-plugins",
    "x-sdkwork-api-authority": "sdkwork-plugins.app"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:18101"
    }
  ],
  "tags": [
    {
      "name": "plugins",
      "description": "Tenant marketplace catalog of managed plugins."
    }
  ],
  "paths": {
    "/app/v3/api/plugins": {
      "get": {
        "tags": [
          "plugins"
        ],
        "summary": "Plugins plugins.list",
        "description": "Marketplace listing. Returns only catalog-visible plugins (`status` = `active` and not soft-deleted). `sort` accepts `updated_at_desc` or `usage_count_desc` and defaults to `updated_at_desc`. When `featured_only` is true, featured order takes precedence over `sort`. Category and role filters further narrow the already tenant-scoped set.",
        "operationId": "plugins.list",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "One-based page index for offset pagination. Default 1.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "description": "Page size for offset pagination. Default 20, maximum 200.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 200,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque cursor token from a previous list response pageInfo.nextCursor.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Generic free-text search keyword.",
            "schema": {
              "type": "string",
              "maxLength": 256
            }
          },
          {
            "name": "category_code",
            "in": "query",
            "required": false,
            "description": "One plugin category code from the category registry. Omit it, or send `all`, to keep every category.",
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          },
          {
            "name": "role_codes",
            "in": "query",
            "required": false,
            "description": "Comma-separated IAM role codes of the signed-in caller, used as the catalog's role scope. An empty value keeps the all-data view; a value keeps records naming one of these roles plus the records open to every role.",
            "schema": {
              "type": "string",
              "maxLength": 1024
            }
          },
          {
            "name": "featured_only",
            "in": "query",
            "required": false,
            "description": "When true, return only plugins marked for featured placement, ordered by featured order ascending, usage count descending, and plugin key ascending. This ordering is applied before pagination.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Catalog order. `updated_at_desc` sorts by update time newest first and is the default when omitted. `usage_count_desc` sorts by usage count highest first. `featured_only=true` overrides this with featured order.",
            "schema": {
              "type": "string",
              "enum": [
                "updated_at_desc",
                "usage_count_desc"
              ],
              "default": "updated_at_desc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SdkWorkApiResponse"
                    },
                    {
                      "type": "object",
                      "required": [
                        "data"
                      ],
                      "properties": {
                        "data": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "items",
                            "pageInfo"
                          ],
                          "properties": {
                            "items": {
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/PluginRecord"
                              }
                            },
                            "pageInfo": {
                              "$ref": "#/components/schemas/PageInfo"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Problem detail",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401": {
            "description": "Problem detail",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403": {
            "description": "Problem detail",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "Problem detail",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        },
        "security": [
          {
            "AuthToken": [],
            "AccessToken": []
          }
        ],
        "x-sdkwork-owner": "sdkwork-plugins",
        "x-sdkwork-api-authority": "sdkwork-plugins.app",
        "x-sdkwork-domain": "intelligence",
        "x-sdkwork-resource": "plugins",
        "x-sdkwork-public": false,
        "x-sdkwork-api-surface": "app-api",
        "x-sdkwork-request-context": "WebRequestContext",
        "x-sdkwork-permission": "plugins.marketplace.read"
      }
    },
    "/app/v3/api/plugins/{pluginKey}": {
      "get": {
        "tags": [
          "plugins"
        ],
        "summary": "Plugins plugins.retrieve",
        "description": "Marketplace retrieval. A plugin the marketplace listing would not publish (draft, disabled or archived, or soft-deleted) is reported as 404 rather than returned, so an unpublished key cannot be read by guessing it. The backend administration API still reads every record.",
        "operationId": "plugins.retrieve",
        "parameters": [
          {
            "name": "pluginKey",
            "in": "path",
            "required": true,
            "description": "Stable plugin key of the managed plugin.",
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SdkWorkApiResponse"
                    },
                    {
                      "type": "object",
                      "required": [
                        "data"
                      ],
                      "properties": {
                        "data": {
                          "type": "object",
                          "required": [
                            "item"
                          ],
                          "properties": {
                            "item": {
                              "$ref": "#/components/schemas/PluginRecord"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Problem detail",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401": {
            "description": "Problem detail",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403": {
            "description": "Problem detail",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "Problem detail",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        },
        "security": [
          {
            "AuthToken": [],
            "AccessToken": []
          }
        ],
        "x-sdkwork-owner": "sdkwork-plugins",
        "x-sdkwork-api-authority": "sdkwork-plugins.app",
        "x-sdkwork-domain": "intelligence",
        "x-sdkwork-resource": "plugins",
        "x-sdkwork-public": false,
        "x-sdkwork-api-surface": "app-api",
        "x-sdkwork-request-context": "WebRequestContext",
        "x-sdkwork-permission": "plugins.marketplace.read"
      }
    },
    "/app/v3/api/plugin_categories": {
      "get": {
        "tags": [
          "plugins"
        ],
        "summary": "Plugins plugins.listCategories",
        "description": "Marketplace category registry. Returns only catalog-visible categories (`status` = `active` and not soft-deleted) in registry order, so a visitor never sees a chip that files nothing; draft, disabled and archived categories stay visible to the backend administration API only.",
        "operationId": "plugins.listCategories",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "One-based page index for offset pagination. Default 1.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "description": "Page size for offset pagination. Default 20, maximum 200.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 200,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque cursor token from a previous list response pageInfo.nextCursor.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Generic free-text search keyword.",
            "schema": {
              "type": "string",
              "maxLength": 256
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SdkWorkApiResponse"
                    },
                    {
                      "type": "object",
                      "required": [
                        "data"
                      ],
                      "properties": {
                        "data": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "items",
                            "pageInfo"
                          ],
                          "properties": {
                            "items": {
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/PluginCategoryRecord"
                              }
                            },
                            "pageInfo": {
                              "$ref": "#/components/schemas/PageInfo"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Problem detail",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401": {
            "description": "Problem detail",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403": {
            "description": "Problem detail",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "Problem detail",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        },
        "security": [
          {
            "AuthToken": [],
            "AccessToken": []
          }
        ],
        "x-sdkwork-owner": "sdkwork-plugins",
        "x-sdkwork-api-authority": "sdkwork-plugins.app",
        "x-sdkwork-domain": "intelligence",
        "x-sdkwork-resource": "plugins",
        "x-sdkwork-public": false,
        "x-sdkwork-api-surface": "app-api",
        "x-sdkwork-request-context": "WebRequestContext",
        "x-sdkwork-permission": "plugins.marketplace.read"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "AuthToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "AccessToken": {
        "type": "apiKey",
        "in": "header",
        "name": "Access-Token"
      }
    },
    "schemas": {
      "SdkWorkApiResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "data",
          "traceId"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32",
            "enum": [
              0
            ],
            "default": 0,
            "minimum": 0,
            "maximum": 0
          },
          "data": {
            "description": "Operation-specific payload typed per response schema."
          },
          "traceId": {
            "type": "string",
            "format": "uuid",
            "description": "Server-owned request correlation id."
          }
        }
      },
      "PageInfo": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "offset",
              "cursor"
            ]
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "totalItems": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "totalPages": {
            "type": "integer",
            "minimum": 0
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "hasMore": {
            "type": "boolean"
          }
        }
      },
      "SdkWorkPlatformErrorCode": {
        "type": "integer",
        "format": "int32",
        "minimum": 40001,
        "maximum": 79999,
        "description": "Platform or domain error code per API_SPEC.md §15.3."
      },
      "FieldError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "message"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "code": {
            "type": "integer",
            "format": "int32",
            "minimum": 40011,
            "maximum": 40099
          },
          "i18nKey": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          }
        }
      },
      "ProblemDetail": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "type",
          "title",
          "status",
          "code",
          "traceId"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "$ref": "#/components/schemas/SdkWorkPlatformErrorCode"
          },
          "traceId": {
            "type": "string",
            "format": "uuid",
            "description": "Server-owned request correlation id."
          },
          "i18nKey": {
            "type": "string",
            "description": "Optional stable localization key such as errors.result.40001."
          },
          "locale": {
            "type": "string",
            "description": "Optional effective BCP 47 locale used by framework message mapping."
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          }
        }
      },
      "PluginCategoryRecord": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "uuid",
          "categoryCode",
          "name",
          "sortOrder",
          "lifecycleStatus",
          "version",
          "createdAt",
          "updatedAt",
          "nameLocales",
          "descriptionLocales"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "int64",
            "pattern": "^-?[0-9]+$",
            "x-sdkwork-int64-string": true,
            "description": "Snowflake entity id serialized as a decimal string (API_SPEC §13.6)."
          },
          "uuid": {
            "type": "string"
          },
          "categoryCode": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "sortOrder": {
            "type": "integer",
            "format": "int32"
          },
          "lifecycleStatus": {
            "type": "string",
            "enum": [
              "draft",
              "active",
              "disabled",
              "archived",
              "deleted"
            ]
          },
          "version": {
            "type": "string",
            "format": "int64",
            "pattern": "^-?[0-9]+$",
            "x-sdkwork-int64-string": true
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "nameLocales": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "default": {},
            "description": "Localized display names keyed by BCP-47 locale."
          },
          "descriptionLocales": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "default": {},
            "description": "Localized descriptions keyed by BCP-47 locale."
          }
        }
      },
      "PluginRecord": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "uuid",
          "organizationId",
          "ownerUserId",
          "pluginKey",
          "name",
          "versionLabel",
          "implementationType",
          "visibility",
          "manifest",
          "installStatus",
          "tags",
          "allowedRoleCodes",
          "status",
          "version",
          "createdAt",
          "updatedAt",
          "nameLocales",
          "descriptionLocales",
          "iconUrl",
          "usageCount",
          "featured",
          "featuredOrder",
          "featuredTitleLocales",
          "featuredDescriptionLocales",
          "featuredImageUrl"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "int64",
            "pattern": "^-?[0-9]+$",
            "x-sdkwork-int64-string": true,
            "description": "Snowflake entity id serialized as a decimal string (API_SPEC §13.6)."
          },
          "uuid": {
            "type": "string"
          },
          "organizationId": {
            "type": "string",
            "format": "int64",
            "pattern": "^-?[0-9]+$",
            "x-sdkwork-int64-string": true,
            "description": "Organization scope of the record. `0` is the tenant-level sentinel (API_SPEC §13.6)."
          },
          "ownerUserId": {
            "type": "string",
            "format": "int64",
            "pattern": "^-?[0-9]+$",
            "x-sdkwork-int64-string": true,
            "description": "Owner of a `private` plugin; catalog reads scope `private` rows to this user id (API_SPEC §13.6)."
          },
          "pluginKey": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "categoryId": {
            "type": [
              "string",
              "null"
            ],
            "format": "int64",
            "pattern": "^-?[0-9]+$",
            "x-sdkwork-int64-string": true
          },
          "categoryCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "versionLabel": {
            "type": "string"
          },
          "provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "implementationType": {
            "type": "string",
            "enum": [
              "sdkwork-native",
              "rig-rust",
              "openai-agents",
              "langchain",
              "langgraph",
              "crewai",
              "autogen",
              "semantic-kernel",
              "custom"
            ]
          },
          "visibility": {
            "type": "string",
            "enum": [
              "private",
              "organization",
              "tenant",
              "public"
            ]
          },
          "manifest": {
            "type": "object",
            "additionalProperties": true,
            "description": "Plugin manifest as an arbitrary JSON object."
          },
          "installStatus": {
            "type": "string",
            "enum": [
              "available",
              "installed",
              "disabled"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowedRoleCodes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
            },
            "default": [],
            "description": "IAM role codes allowed to see and use this plugin. An empty list means every role (the default)."
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "active",
              "disabled",
              "archived",
              "deleted"
            ],
            "description": "Entity lifecycle status derived from the stored lifecycleStatus code."
          },
          "version": {
            "type": "string",
            "format": "int64",
            "pattern": "^-?[0-9]+$",
            "x-sdkwork-int64-string": true
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/PluginArtifactSource"
          },
          "nameLocales": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "default": {},
            "description": "Localized display names keyed by BCP-47 locale."
          },
          "descriptionLocales": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "default": {},
            "description": "Localized descriptions keyed by BCP-47 locale."
          },
          "iconUrl": {
            "type": [
              "string",
              "null"
            ],
            "description": "Plugin icon URL resolved through SDKWork media."
          },
          "usageCount": {
            "type": "string",
            "format": "int64",
            "pattern": "^-?[0-9]+$",
            "x-sdkwork-int64-string": true,
            "description": "Usage count used for catalog ranking and display."
          },
          "featured": {
            "type": "boolean",
            "default": false,
            "description": "Whether the plugin is eligible for featured placement."
          },
          "featuredOrder": {
            "type": "integer",
            "format": "int32",
            "default": 0,
            "description": "Lower values appear first among featured plugins."
          },
          "featuredTitleLocales": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "default": {},
            "description": "Localized featured-card titles keyed by BCP-47 locale."
          },
          "featuredDescriptionLocales": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "default": {},
            "description": "Localized featured-card descriptions keyed by BCP-47 locale."
          },
          "featuredImageUrl": {
            "type": [
              "string",
              "null"
            ],
            "description": "Featured-card image URL resolved through SDKWork media."
          }
        }
      },
      "PluginArtifactDriveFileSource": {
        "type": "object",
        "additionalProperties": false,
        "description": "An archive uploaded to sdkwork-drive. checksumSha256 is the SHA-256 of the archive bytes.",
        "required": [
          "kind",
          "driveUri",
          "checksumSha256"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "drive_file"
            ]
          },
          "driveUri": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^drive://spaces/[^/]+/nodes/[^/]+$"
          },
          "checksumSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sizeBytes": {
            "type": [
              "string",
              "null"
            ],
            "format": "int64",
            "pattern": "^[0-9]+$",
            "x-sdkwork-int64-string": true
          }
        }
      },
      "PluginArtifactDriveDirectorySource": {
        "type": "object",
        "additionalProperties": false,
        "description": "An existing sdkwork-drive folder. The runtime materializes the folder contents as the plugin package.",
        "required": [
          "kind",
          "driveUri"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "drive_directory"
            ]
          },
          "driveUri": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^drive://spaces/[^/]+/nodes/[^/]+$"
          }
        }
      },
      "PluginArtifactGitSource": {
        "type": "object",
        "additionalProperties": false,
        "description": "A path inside an https Git repository. Consumers clone the repository at the pinned revision.",
        "required": [
          "kind",
          "repositoryUrl",
          "repositoryPath"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "git"
            ]
          },
          "repositoryUrl": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^https://[A-Za-z0-9][A-Za-z0-9.-]*(?::[0-9]{1,5})?/[^\\s]+$"
          },
          "repositoryPath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[^\\\\]+$"
          },
          "gitRef": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[A-Za-z0-9._/-]+$"
          }
        }
      },
      "PluginArtifactSource": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/PluginArtifactDriveFileSource"
          },
          {
            "$ref": "#/components/schemas/PluginArtifactDriveDirectorySource"
          },
          {
            "$ref": "#/components/schemas/PluginArtifactGitSource"
          }
        ],
        "discriminator": {
          "propertyName": "kind"
        },
        "description": "Plugin artifact content source: a Drive archive, an existing Drive directory, or a Git repository path."
      }
    }
  },
  "x-sdkwork-standard-profile": "sdkwork-v3"
}
