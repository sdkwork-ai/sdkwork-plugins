      "required": true,
      "role": "api-standalone-gateway"
     },
     {
      "id": "plugins-browser",
      "role": "client",
      "applicationRoot": "apps/sdkwork-plugins-pc",
      "bindEnv": "SDKWORK_MCP_WEB_DEV_INGRESS_BIND",
      "runtimeTargets": [
       "browser"
      ],
      "clientArchitectures": [
       "pc-web",
       "h5"
      ],
      "required": true
     }
    ],
    "healthSurfaces": [
     "application.public-ingress"
    ],
    "browserDeliveries": [
     {
      "id": "plugins-adaptive-web",
      "applicationRoot": "apps/sdkwork-plugins-pc",
      "clientArchitectures": [
       "pc-web",
       "h5"
      ],
      "originMode": "same-origin",
      "deliveryMode": "dev-server-proxy",
      "clientProcessId": "plugins-browser",
      "apiSurfaceId": "application.public-ingress",
      "preserveCanonicalPaths": true,
      "tabletArchitecture": "pc-web",
      "renderers": {
       "pc-web": {
        "applicationRoot": "apps/sdkwork-plugins-pc",
        "script": "dev",
        "defaultPort": 5632,
        "portEnv": "SDKWORK_MCP_PC_INTERNAL_DEV_PORT",
        "env": {}
       },
       "h5": {
        "applicationRoot": "apps/sdkwork-plugins-pc",
