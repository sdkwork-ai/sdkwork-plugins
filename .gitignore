# ---- auto-audited: local artifacts that must never be committed ----
*.key
*.pem
*.p12
*.pfx
*.keystore
tmp/
temp/
*.tmp
*.temp
.cache/
.turbo/
.next/
build/
target/

# TypeScript compiler output emitted next to SDK sources (build artifacts, never commit)
sdks/**/sdkwork-plugins-backend-sdk-typescript/**/*.js
sdks/**/sdkwork-plugins-backend-sdk-typescript/**/*.js.map
sdks/**/sdkwork-plugins-backend-sdk-typescript/**/*.d.ts
sdks/**/sdkwork-plugins-backend-sdk-typescript/**/*.d.ts.map

# Logs (never commit)
*.log

# TypeScript compiler output emitted next to the app SDK sources (same rule)
sdks/**/sdkwork-plugins-app-sdk-typescript/**/*.js
sdks/**/sdkwork-plugins-app-sdk-typescript/**/*.js.map
sdks/**/sdkwork-plugins-app-sdk-typescript/**/*.d.ts
sdks/**/sdkwork-plugins-app-sdk-typescript/**/*.d.ts.map
sdks/**/.sdkwork/manual-backups/

# Compiled output of the PC marketplace package (sources are .ts/.tsx)
apps/sdkwork-plugins-pc/packages/sdkwork-plugins-pc-marketplace/src/**/*.js
apps/sdkwork-plugins-pc/packages/sdkwork-plugins-pc-marketplace/src/**/*.js.map
apps/sdkwork-plugins-pc/packages/sdkwork-plugins-pc-marketplace/src/**/*.d.ts
apps/sdkwork-plugins-pc/packages/sdkwork-plugins-pc-marketplace/src/**/*.d.ts.map
!apps/sdkwork-plugins-pc/packages/sdkwork-plugins-pc-marketplace/src/global.d.ts
!apps/sdkwork-plugins-pc/packages/sdkwork-plugins-pc-marketplace/src/css-modules.d.ts

# Local debugging probes reference absolute machine paths and must stay untracked
**/.probe-entry.*
